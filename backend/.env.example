# ─────────────────────────────────────────────────
# Planet Maritime Intelligence — Backend .env
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────

# HTTP server port (Express)
PORT=3000

# MongoDB connection string
# Local:   mongodb://localhost:27017/planet_maritime
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/planet_maritime
DATABASE_URL=mongodb://localhost:27017/planet_maritime

# Redis connection URI
# Local:   redis://localhost:6379
# Upstash: rediss://:<token>@<host>:<port>
REDIS_URL=redis://localhost:6379

# JWT signing secret — must be a long, random, unguessable string
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Allowed CORS origin — the URL of your Vite/React frontend
# Development: http://localhost:5173
# Production:  https://your-domain.com
CLIENT_ORIGIN=http://localhost:5173

# FastAPI ML microservice URL
# Local development (default):
ML_SERVICE_URL=http://localhost:8000
